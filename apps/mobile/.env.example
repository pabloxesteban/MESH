# Entorno de @mesh/mobile.
#
# Copiá este archivo a apps/mobile/.env.local.
#
# Solo las variables con prefijo EXPO_PUBLIC_ son legibles desde el código de la
# app, y todas ellas viajan en el bundle: son públicas por diseño. Eso está bien.
# Lo que protege los datos NO es el secreto de estas claves, es RLS.
# Ver docs/security/security-model.md §1 y §7.
#
# Si alguna vez sentís la necesidad de poner acá una clave que no querés que se
# vea, esa clave no va en esta app.

# URL del proyecto Supabase.
# Local con `supabase start`: http://127.0.0.1:54321
EXPO_PUBLIC_SUPABASE_URL=

# Anon key ("publishable"). Pública por diseño — está pensada para publicarse.
EXPO_PUBLIC_SUPABASE_ANON_KEY=
