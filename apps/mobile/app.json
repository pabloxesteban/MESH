{
  "expo": {
    "name": "MESH",
    "slug": "mesh",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "mesh",
    "userInterfaceStyle": "automatic",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "app.mesh.client"
    },
    "android": {
      "package": "app.mesh.client",
      "adaptiveIcon": {
        "backgroundColor": "#0C0C0E",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-font",
      "expo-secure-store",
      "expo-image",
      "expo-sqlite",
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "MESH usa tu ubicación para mostrarte a cuántos kilómetros está cada estudio. Nunca la compartimos con nadie."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
