# dependencias
node_modules/
.pnp/
.pnp.js

# expo
.expo/
.expo-shared/
dist/
web-build/
expo-env.d.ts
.metro-health-check*
.kotlin/
*.jks
*.p8
*.p12
*.key
*.mobileprovision
*.orig.*

# builds nativos
ios/
android/
*.ipa
*.apk
*.aab

# entorno y secretos — nunca commitear
.env
.env.*
!.env.example
*.pem
service-role*
supabase/.temp/
supabase/.branches/

# salida de build
build/
coverage/
*.tsbuildinfo
.turbo/

# media local de trabajo (binarios grandes — se suben a Storage, no se versionan)
content/media/
!content/media/.gitkeep

# Originales de artistas. Quedan con el artista, no en el repositorio: un
# repositorio no es el lugar donde se custodia la obra de otra persona, y un
# retiro tiene que poder cumplirse sin reescribir la historia de git.
# Las de los fixtures se regeneran con `npm run content:fixtures`.
content/artists/*/media/

# herramientas
.DS_Store
Thumbs.db
*.log
npm-debug.log*
yarn-error.log*
.eslintcache
.vscode/
!.vscode/extensions.json
.idea/

# artefactos de tests
.maestro/output/
playwright-report/
test-results/
