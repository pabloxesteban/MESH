{
  "name": "mesh",
  "version": "0.1.0",
  "private": true,
  "description": "MESH — descubrí gente, hacé que las ideas pasen",
  "workspaces": [
    "apps/mobile",
    "packages/domain",
    "tools/seed",
    "tools/brand"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "check": "npm run typecheck && npm run lint && npm run test && npm run content:validate",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "test": "npm run test --workspaces --if-present",
    "test:domain": "npm run test -w @mesh/domain",
    "content:validate": "npm run validate -w @mesh/seed",
    "mobile": "npm run start -w @mesh/mobile",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:reference": "npm run reference -w @mesh/seed",
    "db:reference:check": "npm run reference:check -w @mesh/seed",
    "db:types": "node scripts/generate-db-types.mjs",
    "db:types:check": "node scripts/generate-db-types.mjs --check",
    "db:test": "supabase test db",
    "db:stop": "supabase stop",
    "secrets:scan": "node scripts/scan-secrets.mjs",
    "brand:icons": "npm run icons -w @mesh/brand",
    "brand:proof": "npm run proof -w @mesh/brand",
    "brand:specimen": "npm run specimen -w @mesh/brand",
    "web:preview": "node scripts/build-web-preview.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "prettier": "^3.9.6",
    "supabase": "^2.114.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0"
  },
  "overrides": {
    "jest": "^29.7.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-test-renderer": "19.2.3"
  }
}
