# Entorno de @mesh/seed.
#
# Copiá este archivo a tools/seed/.env.local y completalo.
# .env.local está en .gitignore y NUNCA se commitea.
#
# ⚠️  Todo lo de acá es un secreto real. La service-role key saltea RLS por
#     completo: quien la tenga puede leer y escribir todas las filas de todos
#     los usuarios. Nunca la pongas en apps/, nunca en una variable
#     EXPO_PUBLIC_*, nunca en un log, nunca en un commit.
#     Ver docs/security/security-model.md §7 y threat-model §T5.

# URL del proyecto Supabase (local: http://127.0.0.1:54321)
SUPABASE_URL=

# Clave service-role. Saltea RLS. Solo en la máquina del operador y en CI.
SUPABASE_SERVICE_ROLE_KEY=

# A qué entorno se carga: local | staging | production
# En 'production' la carga falla si hay alguna fila fixture.
SEED_TARGET=local
