{
  "name": "@mesh/seed",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "CLI de carga de contenido de MESH. Usa la service-role key \u2014 nunca se empaqueta en la app.",
  "scripts": {
    "typecheck": "tsc --noEmit",
    "validate": "node --experimental-strip-types src/validate.ts",
    "seed": "node --experimental-strip-types src/seed.ts",
    "reference": "node --experimental-strip-types src/reference.ts",
    "reference:check": "node --experimental-strip-types src/reference.ts --check",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "fixtures": "node --experimental-strip-types src/fixtures.ts",
    "new": "node --experimental-strip-types src/new-artist.ts",
    "claim": "node --experimental-strip-types src/claim-code.ts"
  },
  "dependencies": {
    "@mesh/domain": "*",
    "@supabase/supabase-js": "^2.112.3",
    "blurhash": "^2.0.5",
    "sharp": "^0.35.3",
    "yaml": "^2.9.0"
  },
  "devDependencies": {
    "@types/node": "^26.2.0"
  }
}
